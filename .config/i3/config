# key variables
set $mod Mod4
set $mod2 Mod1

# ventana enfocada
#client.focused          #border   #background   #text   #indicator   #child_border
#client.unfocused        #border   #background   #text   #indicator   #child_border
#client.focused_inactive #border   #background   #text   #indicator   #child_border
#client.urgent           #border   #background   #text   #indicator   #child_border


# Definición de colores (Variables)
set $bg-dark      #1A0B2E
set $purple-bright #000000
set $magenta-neon  #FF00E5
set $lavender-text #E0AAFF
set $inactive-bg   #3C096C
set $urgent-red    #FF5400


# Colores exclusivos para las ventanas (Interface)
set $ventana-activa-borde  #BD93F9
set $ventana-activa-bg     #3C096C
set $ventana-activa-texto  #ffffff

set $ventana-inactiva-bg    #120521
set $ventana-inactiva-texto #6272A4

set $indicador-split       #FF79C6
# Clase                 Borde                  Fondo                  Texto                  Indicador          Borde_Hijo
# ---------------------------------------------------------------------------------------------------------------------------
# La ventana que usás: Borde lila claro, fondo oscuro sólido y texto casi blanco.
client.focused          $ventana-activa-borde  $ventana-activa-bg     $ventana-activa-texto  $indicador-split   $ventana-activa-borde

# Ventanas en segundo plano: El texto se "apaga" y el borde se funde con el wallpaper.
client.unfocused        $ventana-inactiva-bg   $ventana-inactiva-bg   $ventana-inactiva-texto $ventana-inactiva-bg $ventana-inactiva-bg

# Ventana enfocada pero en otro monitor (si tenés varios) o inactiva en el stack.
client.focused_inactive $ventana-inactiva-bg   $ventana-inactiva-bg   $ventana-inactiva-texto $ventana-inactiva-bg $ventana-inactiva-bg

# Urgente: Rojo vibrante para que destaque sí o sí.
client.urgent           #FF5555                #FF5555                #FFFFFF                #FF5555            #FF5555
#client.focused          #5219be  #5219be  #ffffff  #ffffff  #5219be

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xbindkeys
exec --no-startup-id picom
exec --no-startup-id dunst

# border config
default_border pixel 4
smart_borders on

#gasp
gaps inner 18
smart_gaps off


# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet

exec --no-startup-id feh --bg-scale ~/Pictures/wallpaper/purpleSky.jpg --bg-scale ~/Pictures/wallpaper/purpleSky.jpg

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +3% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -3% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

bindsym $mod+XF86AudioRaiseVolume exec --no-startup-id ~/Scripts/ruidoBlanco.sh volumeUp 3
bindsym $mod+XF86AudioLowerVolume exec --no-startup-id ~/Scripts/ruidoBlanco.sh volumeDown 3
bindsym $mod+XF86AudioPlay exec --no-startup-id ~/Scripts/ruidoBlanco.sh toggle

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 1%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 1%-

bindsym XF86AudioNext exec dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next
bindsym XF86AudioPrev exec dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous
bindsym XF86AudioPlay exec dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause
bindsym XF86AudioPause exec dbus-send --print-reply --dest=org.mpris.MediaPlayer2.spotify /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Pause

bindsym XF86Tools exec --no-startup-id ~/Scripts/switchsound.sh

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec alacritty

# kill focused window
bindsym $mod+period kill

# start (a program launcher)
bindsym $mod+p exec --no-startup-id jgmenu_run

bindsym $mod+Shift+p exec --no-startup-id ~/Scripts/$(ls ~/Scripts/ | dmenu)

#toggle fullscrean
bindsym $mod+f fullscreen toggle

#toggle float
bindsym $mod+space floating toggle

bindsym $mod+w bar mode toggle
bindsym $mod+Shift+w bar mode toggle

#restart i3 interface
bindsym $mod+Shift+r restart

#take simple screenshot
bindsym --release $mod+t exec --no-startup-id ~/Scripts/screenshot.sh

#take selected screenshot
bindsym --release $mod+Shift+t exec --no-startup-id ~/Scripts/sscreenshot.sh

# Open scripts
bindsym $mod+j exec ~/Scripts/checklist.sh

# Dunst notification controls
#bindsym $mod+n exec ~/.local/bin/dunst-history-rofi.sh
#bindsym $mod+Shift+n exec dunstctl close
#bindsym $mod+Ctrl+n exec dunstctl close-all
#bindsym $mod+Shift+p exec dunstctl set-paused toggle

# change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Tab focus down
bindsym $mod+Shift+Tab focus up

#hide window
#bindsym $mod+Shift+space hide

# change position
bindsym $mod+Home move left
bindsym $mod+Next move down
bindsym $mod+Prior move up
bindsym $mod+End move right

# toggle sticky windows
bindsym $mod+comma sticky toggle
bindsym $mod+Shift+comma exec ~/Scripts/transWin.sh

#bindsym $mod+i focus parent

