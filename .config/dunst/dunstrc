[global]
    ### Display ###
    monitor = 0
    follow = mouse
    width = 420           # ancho mayor
    height = 130          # altura mayor
    origin = top-right
    offset = 20x50
    scale = 0
    notification_limit = 4
    transparency = 25
    padding = 16
    horizontal_padding = 16
    frame_width = 2
    frame_color = "#BD93F9"   # borde lila brillante
    corner_radius = 16         # más redondeado, estilo girl
    separator_color = frame
    sort = yes

    ### Text ###
    font = "JetBrains Mono Nerd Font" 14
    line_height = 1.3
    markup = full
    format = "<b>%s</b>\\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    foreground = "#FFFFFF"     # texto siempre blanco

    ### Behavior ###
    sticky_history = yes
    history_length = 50
    idle_threshold = 120
    browser = xdg-open
    always_run_script = true
    title = Dunst 🌸

    ### Misc/Advanced ###
    dmenu = /usr/bin/rofi -dmenu -p "Notifications"
    stack_tags = yes

[experimental]
    per_monitor_dpi = false

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    timeout = 4
    background = "#1A0B2E"   # fondo oscuro profundo
    frame_color = "#BD93F9"   # borde lila brillante
    foreground = "#FFFFFF"

[urgency_normal]
    timeout = 5
    background = "#2B0C50"   # morado oscuro
    frame_color = "#BD93F9"   # borde lila brillante
    foreground = "#FFFFFF"

[urgency_critical]
    timeout = 0
    background = "#3C096C"   # morado más intenso
    frame_color = "#FF5400"   # rojo para urgencia máxima
    foreground = "#FFFFFF"
